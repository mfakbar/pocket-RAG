{
  "name": "pocketai",
  "productName": "RavnDock",
  "version": "1.1.0",
  "description": "Local-first AI knowledge assistant for private document chat.",
  "main": "./out/main/index.js",
  "author": "Muhammad F. Akbar",
  "homepage": "https://github.com/mfakbar/pocket-RAG",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pretest": "node -e \"require('node:fs').rmSync('.test-out',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/tests/*.test.js",
    "test:backend": "rag-backend/.venv/bin/python -m unittest discover -s rag-backend/tests -v",
    "rag:release-gate": "rag-backend/.venv/bin/python rag-backend/benchmark/release_evaluation.py",
    "rag:regression-check": "rag-backend/.venv/bin/python -m unittest discover -s rag-backend/tests -p 'test_regression_dataset.py' -v",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "release:check": "node scripts/release-preflight.mjs",
    "release:dmg": "node scripts/release-preflight.mjs --strict && npm run build && electron-builder --mac dmg --arm64 -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "release:verify-dmg": "node scripts/verify-dmg.mjs",
    "appstore:check": "node scripts/appstore-preflight.mjs",
    "build:mas": "node scripts/appstore-preflight.mjs --strict && npm run build && electron-builder --mac mas --arm64",
    "build:mas-dev": "node scripts/appstore-preflight.mjs --strict --development && npm run build && electron-builder --mac mas-dev --arm64",
    "dist": "electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.1.1",
    "electron-builder": "26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.6"
  }
}
